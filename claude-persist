#!/usr/bin/env python3
"""claude-persist: bring tmux sessions and Claude Code conversations back after a reboot.

  claude-persist snapshot                 record tmux sessions/windows/panes and the Claude session in each pane
  claude-persist restore [--dry-run]      recreate missing tmux sessions and resume each Claude conversation
  claude-persist status                   show the last snapshot, i.e. what a restore would bring back
  claude-persist install [--global USER]  set up hooks, systemd units and the timer (see cmd_install)
  claude-persist hook start|end           Claude Code SessionStart/SessionEnd hook

README.md explains how it works and why. Internal (tests): _pane-session <pane>, _answer-trust <pane>.
Environment: CLAUDE_PERSIST_WEBHOOK_FILE (Discord summary), and for tests CLAUDE_PERSIST_SOCKET (tmux -L name),
CLAUDE_PERSIST_STATE, CLAUDE_PERSIST_MARKER, CLAUDE_PERSIST_NOTIFY=0, CLAUDE_PERSIST_VERIFY_WAIT.
"""
import contextlib
import fcntl
import glob
import json
import os
import pwd
import shlex
import shutil
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CLAUDE_DIR = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude")
STATE = os.environ.get("CLAUDE_PERSIST_STATE") or os.path.join(HOME, ".local/state/claude-persist")
SOCKET = os.environ.get("CLAUDE_PERSIST_SOCKET")
SNAP, PREV, PRE_RESTORE = (os.path.join(STATE, f) for f in ("snapshot.json", "snapshot.prev.json", "snapshot.pre-restore.json"))
LOCK, LOG, HOOKLOG, PIDS = (os.path.join(STATE, f) for f in ("restore.lock", "claude-persist.log", "hooks.log", "pids"))
WEBHOOK = os.environ.get("CLAUDE_PERSIST_WEBHOOK_FILE") or os.path.join(HOME, ".config/claude-persist/discord-webhook")
# Exists once restore has run since this user manager started (XDG_RUNTIME_DIR is emptied when it stops). Until then a
# snapshot must not replace the last one, which is what the restore will read.
MARKER_NAME = "claude-persist.restored"
MARKER = os.environ.get("CLAUDE_PERSIST_MARKER") or os.path.join(
    os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", MARKER_NAME)
TMUX = ["tmux", *(["-L", SOCKET] if SOCKET else [])]
PANE_FMT = "#{session_id}\t#{window_index}\t#{pane_id}\t#{pane_pid}"
ENABLED = ("claude-persist-restore.service", "claude-persist-snapshot.timer")
SYSTEM_EXE = "/usr/local/bin/claude-persist"
# Launch flags carried into the resumed process (allow-list: unknown flags are dropped, and reported). Prompts, -c,
# --resume, --session-id, --fork-session, --name, --worktree, --bg, ... must never be replayed.
KEEP_BOOL = {"--dangerously-skip-permissions", "--verbose", "--chrome", "--no-chrome", "--strict-mcp-config",
             "--restricted", "--safe-mode"}
KEEP_VAL = {"--permission-mode", "--model", "--effort", "--agent", "--settings", "--system-prompt",
            "--append-system-prompt", "--setting-sources", "--agents", "--max-budget-usd"}
KEEP_MULTI = {"--add-dir", "--mcp-config", "--allowedTools", "--allowed-tools", "--disallowedTools",
              "--disallowed-tools", "--tools", "--plugin-dir"}
NOT_INTERACTIVE = {"daemon", "mcp", "remote-control", "agents", "attach", "update", "install", "doctor"}


# ---------------------------------------------------------------- small helpers
def log(msg, path=LOG):
    try:
        with open(path, "a") as f:                     # never creates STATE: only snapshot/restore/install do
            f.write(time.strftime("%F %T ") + msg + "\n")
    except OSError:
        pass


def tmux(*args, timeout=10):
    return subprocess.run([*TMUX, *args], capture_output=True, text=True, timeout=timeout, check=False)


def load_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=1)
    os.replace(tmp, path)


@contextlib.contextmanager
def state_lock(tries=1):
    """Exclusive lock shared by snapshot and restore; yields whether it was acquired within `tries` seconds."""
    os.makedirs(PIDS, exist_ok=True)                    # the hook writes here; it never creates STATE itself
    with open(LOCK, "a") as lk:
        for i in range(tries):
            try:
                fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if i + 1 < tries:
                    time.sleep(1)
        else:
            yield False
            return
        yield True


def touch_marker(path=None, owner=None):
    """Create the restore marker; False (and logged) when the runtime dir is missing, e.g. no systemd user session."""
    path = path or MARKER
    try:
        with open(path, "a"):
            pass
        if owner:
            os.chown(path, owner.pw_uid, owner.pw_gid)
    except OSError as e:
        log(f"cannot create {path} ({e}); snapshots stay paused until it exists")
        return False
    return True


def shutting_down():
    """True while the system or this user manager is stopping: tmux may already be gone, and an empty snapshot then
    would replace the one the next boot restores."""
    for scope in ([], ["--user"]):
        try:
            r = subprocess.run(["systemctl", *scope, "is-system-running"], capture_output=True, text=True,
                               timeout=5, check=False)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if r.stdout.strip() == "stopping":
            return True
    return False


def proc_stat(pid):
    """Fields of /proc/<pid>/stat after the command name (index 0 = state), or None."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            return f.read().rsplit(")", 1)[1].split()
    except (OSError, IndexError):
        return None


def start_ticks(pid):
    st = proc_stat(pid)
    return st[19] if st else None


def cmdline(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
    except OSError:
        return []


def any_claude_args(argv):
    """Claude's own arguments if argv is any Claude Code process (interactive or not), else None."""
    if argv and os.path.basename(argv[0]) in ("node", "bun"):      # npm-installed claude
        argv = argv[1:]
        if not argv or "claude" not in argv[0]:
            return None
    elif not argv or os.path.basename(argv[0]) != "claude":
        return None
    return argv[1:]


def claude_args(argv):
    """Claude's own arguments if argv is an interactive Claude Code process, else None."""
    args = any_claude_args(argv)
    if args is None or (args[:1] and args[0] in NOT_INTERACTIVE) or "-p" in args or "--print" in args:
        return None
    return args


def children(pid):
    out = []
    for f in glob.glob(f"/proc/{pid}/task/*/children"):
        try:
            with open(f) as fh:
                out += [int(x) for x in fh.read().split()]
        except OSError:
            pass
    return out


def claude_in_pane(pane_pid):
    """The interactive Claude in a pane: the terminal's foreground process first, then a search of the pane's own
    descendants (no scan of every process on the machine)."""
    st = proc_stat(pane_pid)
    queue = [*([int(st[5])] if st and st[5].isdigit() and int(st[5]) > 0 else []), pane_pid]
    seen = set()
    while queue:
        pid = queue.pop(0)
        if pid in seen:
            continue
        seen.add(pid)
        if claude_args(cmdline(pid)) is not None:
            return pid
        queue += children(pid)
    return None


def hook_record(pid):
    """What the SessionStart/End hook recorded for this exact process (pid + start time), or {}."""
    rec = load_json(os.path.join(PIDS, f"{pid}.json")) or {}
    return rec if rec.get("start") == start_ticks(pid) else {}


def claude_pid_file(pid):
    """Claude Code's own record for this exact process, or {}."""
    pf = load_json(os.path.join(CLAUDE_DIR, "sessions", f"{pid}.json")) or {}
    return pf if str(pf.get("procStart", "")) == start_ticks(pid) else {}


def session_of(cpid):
    """(session_id, source, ended) for a running Claude process."""
    rec = hook_record(cpid)
    if rec:
        return rec.get("session_id"), "hook", bool(rec.get("ended"))
    sid = claude_pid_file(cpid).get("sessionId")
    return sid, ("pidfile" if sid else "unknown"), False


def pane_session(pane_pid):
    """(claude_pid, session_id, source) for a pane, or (None, None, None)."""
    cpid = claude_in_pane(pane_pid)
    return (cpid, *session_of(cpid)[:2]) if cpid else (None, None, None)


def pane_pid_of(target):
    return int(tmux("display-message", "-p", "-t", target, "#{pane_pid}").stdout)


def transcript_exists(sid):
    return bool(sid) and bool(glob.glob(os.path.join(CLAUDE_DIR, "projects", "*", f"{sid}.jsonl")))


def recorded_pids(directory):
    return [os.path.basename(f)[:-5] for f in glob.glob(os.path.join(directory, "*.json"))]


def live_session_ids():
    """Every session id some live Claude process is running (interactive, background or print; pid reuse checked)."""
    return ({claude_pid_file(p).get("sessionId") for p in recorded_pids(os.path.join(CLAUDE_DIR, "sessions"))}
            | {hook_record(p).get("session_id") for p in recorded_pids(PIDS)}) - {None, ""}


def carried_flags(args):
    """Split Claude's arguments into (kept, dropped) launch flags."""
    kept, dropped, i = [], [], 0
    while i < len(args):
        a = args[i]
        key = a.split("=", 1)[0]
        if a in KEEP_BOOL:
            kept.append(a)
        elif key in KEEP_VAL and "=" not in a:          # exactly one value, even one starting with "-"
            kept += args[i:i + 2]
            i += 1
        elif key in KEEP_VAL or key in KEEP_MULTI:      # --flag=value, or every value up to the next option
            kept.append(a)
            while "=" not in a and i + 1 < len(args) and not args[i + 1].startswith("-"):
                i += 1
                kept.append(args[i])
        elif a.startswith("-") and key not in ("--resume", "-r", "--continue", "-c", "--session-id", "--name", "-n"):
            dropped.append(a)
        i += 1
    return kept, dropped


def iter_panes(snap):
    for s in snap["sessions"]:
        for w in s["windows"]:
            for p in w["panes"]:
                yield s, w, p


def login_shell():
    return os.environ.get("SHELL") or pwd.getpwuid(os.getuid()).pw_shell or "/bin/bash"


# ---------------------------------------------------------------- snapshot
def take_snapshot():
    fmt = "\t".join(["#{session_name}", "#{window_index}", "#{window_name}", "#{window_layout}", "#{window_active}",
                     "#{automatic-rename}", "#{pane_index}", "#{pane_pid}", "#{pane_current_path}", "#{pane_active}",
                     "#{@claude_persist_pane_command}"])
    r = tmux("list-panes", "-a", "-F", fmt)
    gone = ("no server running", "error connecting", "server exited unexpectedly")      # the last: mid-shutdown
    if r.returncode != 0 and (not any(g in r.stderr for g in gone) or shutting_down()):
        return None                                     # tmux failed otherwise, or is going down with the machine
    sessions = []                                       # tmux lists sessions, windows and panes in order
    for line in r.stdout.splitlines():
        sname, widx, wname, layout, wact, auto, pidx, ppid, pcwd, pact, was_cmd = line.split("\t")
        if not sessions or sessions[-1]["name"] != sname:
            sessions.append({"name": sname, "windows": []})
        wins = sessions[-1]["windows"]
        if not wins or wins[-1]["index"] != int(widx):
            wins.append({"index": int(widx), "name": wname, "layout": layout, "active": wact == "1",
                         "automatic_rename": auto == "1", "panes": []})
        pane = {"index": int(pidx), "cwd": pcwd, "active": pact == "1", "claude": None}
        cpid = claude_in_pane(int(ppid))
        if cpid:
            sid, source, ended = session_of(cpid)
            if not ended:                               # a deliberate /exit in progress: do not bring it back
                with contextlib.suppress(OSError):
                    pane["cwd"] = claude_pid_file(cpid).get("cwd") or os.readlink(f"/proc/{cpid}/cwd")
                kept, dropped = carried_flags(claude_args(cmdline(cpid)) or [])
                pane["claude"] = {"session_id": sid, "id_source": source, "flags": kept, "dropped_flags": dropped,
                                  "pane_command": int(ppid) == cpid or was_cmd == "1"}
        wins[-1]["panes"].append(pane)
    return {"version": 2, "taken_at": time.strftime("%F %T"), "host": os.uname().nodename,
            "user": os.environ.get("USER", ""), "sessions": sessions}


def prune_hook_records():
    for pid in recorded_pids(PIDS):
        if not hook_record(pid):                        # process gone, or pid reused
            with contextlib.suppress(OSError):
                os.remove(os.path.join(PIDS, f"{pid}.json"))


def cmd_snapshot():
    if not os.path.exists(MARKER):
        return 0                                        # restore has not run since boot: keep what it will read
    with state_lock() as locked:
        if not locked:
            return 0                                    # a restore is running
        prune_hook_records()
        snap = take_snapshot()
        if snap is None:
            return 0
        old = load_json(SNAP)
        if old and {**old, "taken_at": None} == {**snap, "taken_at": None}:
            os.utime(SNAP)
            return 0
        if old:
            shutil.copyfile(SNAP, PREV)                 # keep the previous distinct state as a fallback
        write_json(SNAP, snap)
    return 0


# ---------------------------------------------------------------- restore
def skip_reason(c, live):
    """Why a recorded Claude pane cannot be resumed, or None."""
    if not c["session_id"]:
        return "session unknown"
    if c["session_id"] in live:
        return "already running elsewhere"
    if not transcript_exists(c["session_id"]):
        return "no saved conversation"
    return None


def claude_command(c):
    return " ".join(["claude"] + [shlex.quote(f) for f in c["flags"]] + ["--resume", shlex.quote(c["session_id"])])


def pane_command(p, live):
    """(skip_reason, tmux shell-command list) for one pane. Claude is the pane's first command, never typed in."""
    c = p["claude"]
    if not c:
        return None, []
    why = skip_reason(c, live)
    if why:
        return why, []
    live.add(c["session_id"])                           # never resume one conversation in two panes
    sh = shlex.quote(login_shell())
    after = "||" if c["pane_command"] else ";"         # a pane that WAS Claude closes on a normal exit, like before
    inner = f"cd {shlex.quote(p['cwd'])} && {claude_command(c)} {after} exec {sh} -l"
    return None, [f"exec {sh} -lic {shlex.quote(inner)}"]


def answer_trust_prompt(pane_pid, pane_id):
    """Claude stops at a folder-trust prompt whose cursor starts on "No, exit" (always for $HOME, whose trust Claude
    never keeps). Steer it to "Yes" one key per call, judged from the screen: Down while the cursor is on "No", Enter
    only once the screen shows it on "Yes". Claude draws the dialog before it reads keys; keys sent early arrive
    together and Enter acts on the old cursor, choosing "No, exit" (seen in a real boot, 2026-11-08). Only while
    the pane's Claude has not reached SessionStart yet (the prompt comes first), so keys never go into a running
    conversation, and only when the dialog is on the last lines of the screen. Returns the key sent, or None."""
    cpid = claude_in_pane(pane_pid)
    if not cpid or hook_record(cpid):
        return None
    tail = [line for line in tmux("capture-pane", "-p", "-t", pane_id).stdout.splitlines() if line.strip()][-12:]
    if not any("Enter to confirm" in line for line in tail):
        return None
    cursor = next((line for line in tail if "\u276f" in line), "")    # \u276f: the dialog's cursor glyph
    key = "Enter" if "Yes, I trust this folder" in cursor else "Down" if "No, exit" in cursor else None
    if key:
        tmux("send-keys", "-t", pane_id, key)
    return key


def notify(text):
    if os.environ.get("CLAUDE_PERSIST_NOTIFY") == "0" or not os.path.isfile(WEBHOOK):
        return
    import urllib.request  # noqa: PLC0415 -- imported here: ~16ms, used once per boot
    body = json.dumps({"content": text[:1900], "username": "claude-persist", "allowed_mentions": {"parse": []}}).encode()
    for attempt in range(6):                            # the network may not be up yet right after boot
        try:
            with open(WEBHOOK) as f:
                url = f.read().strip()
            req = urllib.request.Request(url, data=body, headers={"Content-Type": "application/json",
                                                                  "User-Agent": "claude-persist"})
            urllib.request.urlopen(req, timeout=15).read()
            return
        except Exception as e:                          # never fail a restore over a notification
            err = type(e).__name__
            code = getattr(e, "code", None)             # HTTPError: a 4xx other than 429 will not get better
            if attempt == 5 or (isinstance(code, int) and 400 <= code < 500 and code != 429):
                break
            time.sleep(10 * (attempt + 1))
    log(f"notify failed: {err}")


def create_session(s, w, tail):
    """Create the session with its first window. When restore runs as a systemd unit and the tmux server is new, the
    server goes into its own scope so it does not live inside the restore service."""
    width, height = w["layout"].split(",")[1].split("x")
    args = ["new-session", "-d", "-P", "-F", PANE_FMT, "-s", s["name"], "-n", w["name"], "-x", width, "-y", height,
            "-c", w["panes"][0]["cwd"], *tail]
    if os.environ.get("INVOCATION_ID") and tmux("list-sessions").returncode != 0 and shutil.which("systemd-run"):
        r = subprocess.run(["systemd-run", "--user", "--scope", "--quiet", "--collect",
                            f"--unit=tmux-server-{os.getpid()}-{int(time.time())}", *TMUX, *args],
                           capture_output=True, text=True, check=False)
        if r.returncode == 0:
            return r
        log(f"restore: systemd-run failed ({r.stderr.strip()}); starting tmux directly")
    return tmux(*args)


def restore_plan(snap):
    """(sessions to create, live session ids)."""
    existing = set(tmux("list-sessions", "-F", "#{session_name}").stdout.splitlines())
    return [s for s in snap["sessions"] if s["name"] not in existing], live_session_ids()


def print_plan(snap, todo, live):
    print(f"snapshot taken {snap['taken_at']}: {len(snap['sessions'])} sessions")
    names = {s["name"] for s in todo}
    for s in snap["sessions"]:
        if s["name"] not in names:
            print(f"  skip session {s['name']}: already exists")
    for s, w, p in iter_panes(snap):
        if s["name"] in names:
            why, _ = pane_command(p, live)
            what = "shell" if not p["claude"] else f"SKIP ({why})" if why else claude_command(p["claude"])
            print(f"  {s['name']}:{w['index']}.{p['index']} [{w['name']}] {p['cwd']}: {what}")


def create_window(s, w, label, sess, *, live, problems):
    """Create window w with its panes (and session s itself when sess is None).
    Returns (session id or None if the session could not be created, [(pane, pane_id, pane_pid, runs_claude)])."""
    created = []
    for i, p in enumerate(w["panes"]):
        why, tail = pane_command(p, live)
        if why:
            problems.append(f"{label} ({why})")
        if i == 0 and sess is None:
            what, out = "session", create_session(s, w, tail)
        elif i == 0:
            what, out = "window", tmux("new-window", "-d", "-P", "-F", PANE_FMT, "-t", f"{sess}:{w['index']}",
                                       "-n", w["name"], "-c", p["cwd"], *tail)
        else:
            what, out = "pane", tmux("split-window", "-d", "-P", "-F", PANE_FMT, "-t", created[-1][1], "-c", p["cwd"], *tail)
        if out.returncode:
            problems.append(f"{label}: could not create {what} ({out.stderr.strip()})")
            break
        new_sess, widx, pane_id, pane_pid = out.stdout.strip().split("\t")
        if sess is None:
            sess = new_sess
            if int(widx) != w["index"]:                 # the first window gets base-index; move it to its old index
                tmux("move-window", "-s", f"{sess}:{widx}", "-t", f"{sess}:{w['index']}")
        created.append((p, pane_id, int(pane_pid), bool(tail)))
    return sess, created


def finish_window(sess, w, label, created, expected):
    """Restore naming, layout, selection; register panes that should come up running Claude."""
    target = f"{sess}:{w['index']}"
    if w["automatic_rename"]:                           # the name came from the pane title: keep it automatic
        tmux("set-option", "-w", "-u", "-t", target, "automatic-rename")
    if len(created) > 1:
        tmux("select-layout", "-t", target, w["layout"])
    for p, pane_id, pane_pid, runs in created:
        if runs:
            expected[pane_id] = (pane_pid, p["claude"]["session_id"], label)
            if p["claude"]["pane_command"]:             # remember it across the wrapper shell for the next reboot
                tmux("set-option", "-p", "-t", pane_id, "@claude_persist_pane_command", "1")
        if p["active"]:
            tmux("select-pane", "-t", pane_id)
    if w["active"]:
        tmux("select-window", "-t", target)


def verify(expected):
    """Poll until each pane runs Claude with the expected session, answering folder-trust prompts. Returns failures."""
    # monotonic: at boot the wall clock can jump (NTP fixing an RTC kept in local time moved it back 1h in a real boot,
    # 2026-11-08, which kept this loop running for an hour instead of a minute)
    deadline = time.monotonic() + float(os.environ.get("CLAUDE_PERSIST_VERIFY_WAIT", "60"))
    pending = dict(expected)
    while pending and time.monotonic() < deadline:
        time.sleep(1)
        for pane_id, (pane_pid, want, label) in list(pending.items()):
            if pane_session(pane_pid)[1] == want:
                del pending[pane_id]
            elif answer_trust_prompt(pane_pid, pane_id) == "Enter":
                log(f"restore: answered folder-trust prompt in {label}")
    failed = []
    for pane_pid, _want, label in pending.values():
        cpid, got, _ = pane_session(pane_pid)
        failed.append(f"{label} ({'not running' if not cpid else 'different session ' + str(got)[:8]})")
    return failed


def cmd_restore(dry):
    snap = load_json(SNAP)
    if dry:
        if snap:
            print_plan(snap, *restore_plan(snap))
        else:
            print("no snapshot - nothing to restore")
        return 0
    with state_lock(tries=30) as locked:                # a snapshot holds the lock for a moment; a restore much longer
        if not locked:
            print("a restore is already running")
            return 0
        if not snap:
            touch_marker()                              # nothing to keep: snapshots may record the current state
            print("no snapshot - nothing to restore")
            return 0
        todo, live = restore_plan(snap)                 # under the lock, so a finished restore's sessions count
        shutil.copyfile(SNAP, PRE_RESTORE)
        expected, problems = {}, []                     # expected: pane_id -> (pane_pid, session_id, label)
        for s in todo:
            sess = None
            for w in s["windows"]:
                label = f"{s['name']}:{w['index']} {w['name']}"
                sess, created = create_window(s, w, label, sess, live=live, problems=problems)
                if sess is None:                        # the session could not be created: skip the rest of it
                    break
                if created:
                    finish_window(sess, w, label, created, expected)
        failed = verify(expected)
        summary = (f"restored {len(todo)} tmux session(s); Claude resumed {len(expected) - len(failed)}/{len(expected)}"
                   + (f"; FAILED: {', '.join(failed)}" if failed else "")
                   + (f"; not resumed: {', '.join(problems)}" if problems else ""))
        log("restore: " + summary)
        print(summary)
        touch_marker()                                  # only after a restore that ran through: snapshots resume
    if todo:
        icon = "\U0001F501" if not failed and not problems else "\u26a0\ufe0f"
        notify(f"{icon} {os.uname().nodename} ({os.environ.get('USER', '')}) after restart: {summary}. "
               f"For any missed: `claude --resume` in that folder.")
    return 0


def cmd_status():
    snap = load_json(SNAP)
    if not snap:
        print("no snapshot yet")
        return 0
    if not os.path.exists(MARKER):
        print("NOTE: snapshots are paused until restore runs this boot (the restore unit needs lingering: "
              "sudo loginctl enable-linger $USER). To resume now: claude-persist restore")
    n = sum(1 for _, _, p in iter_panes(snap) if p["claude"])
    checked = time.strftime("%F %T", time.localtime(os.path.getmtime(SNAP)))
    print(f"snapshot {snap['taken_at']} (checked {checked}) {snap['host']}/{snap['user']}: "
          f"{len(snap['sessions'])} tmux sessions, {n} Claude sessions")
    for s, w, p in iter_panes(snap):
        c = p["claude"]
        if not c:
            desc = "shell"
        else:
            why = skip_reason(c, set())                 # as after a reboot: its own process will not be running
            desc = f"claude {(c['session_id'] or 'unknown')[:8]} via {c['id_source']}" + (f" ({why})" if why else "")
            if c["dropped_flags"]:
                desc += f" dropped flags: {' '.join(c['dropped_flags'])}"
        print(f"  {s['name']}:{w['index']}.{p['index']}  {w['name'][:24]:24}  {desc:34}  {p['cwd']}")
    return 0


# ---------------------------------------------------------------- hook
def cmd_hook(kind):
    try:
        data = json.loads(sys.stdin.read() or "{}") if not sys.stdin.isatty() else {}
    except ValueError:
        data = {}
    try:
        cpid = os.environ.get("CLAUDE_PID", "")
        if not cpid:                                    # older Claude: walk up to the claude process
            pid = os.getppid()
            for _ in range(5):                          # stop at the FIRST claude, so a nested claude -p is not
                if any_claude_args(cmdline(pid)) is not None:   # mistaken for the interactive Claude that started it
                    cpid = str(pid)
                    break
                st = proc_stat(pid)
                if not st:
                    break
                pid = int(st[1])
        if not cpid or claude_args(cmdline(cpid)) is None or not os.path.isdir(PIDS):
            return 0                                    # not an interactive Claude (e.g. claude -p), or not installed
        sid = data.get("session_id") or os.environ.get("CLAUDE_CODE_SESSION_ID", "")
        detail = data.get("source") or data.get("reason") or ""
        log(f"{kind} {detail} sid={sid[:8]} pid={cpid}", HOOKLOG)
        path = os.path.join(PIDS, f"{cpid}.json")
        if kind == "start" and sid:
            write_json(path, {"session_id": sid, "start": start_ticks(cpid), "ended": False})
        elif kind == "end" and data.get("reason") in ("prompt_input_exit", "logout"):
            rec = load_json(path) or {"session_id": sid, "start": start_ticks(cpid)}
            rec["ended"] = True                         # a deliberate exit: do not bring it back after a reboot
            write_json(path, rec)
        if os.path.getsize(HOOKLOG) > 256 * 1024:
            with open(HOOKLOG) as f:
                tail = f.readlines()[-500:]
            with open(HOOKLOG, "w") as f:
                f.writelines(tail)
    except Exception:
        pass                                            # a hook must never disturb the session it reports on
    return 0


# ---------------------------------------------------------------- install
UNITS = {
    "claude-persist-restore.service": """[Unit]
Description=Restore tmux sessions and resume Claude Code conversations after boot (claude-persist)
# without lingering this would run at every login and the restored tmux would die with the user manager at logout
ConditionPathExists=/var/lib/systemd/linger/%u

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={exe} restore
# restore puts a new tmux server in its own scope; this only matters if that falls back to plain tmux
KillMode=process
TimeoutStartSec=600

[Install]
WantedBy=default.target
""",
    "claude-persist-snapshot.service": """[Unit]
Description=Snapshot tmux layout and Claude Code session ids for reboot recovery (claude-persist)
After=claude-persist-restore.service
ConditionPathExists=%t/{marker}

[Service]
Type=oneshot
Nice=10
ExecStart={exe} snapshot
LogLevelMax=notice
""",
    "claude-persist-snapshot.timer": """[Unit]
Description=Every 2 minutes: claude-persist snapshot

[Timer]
OnBootSec=3min
OnUnitActiveSec=2min
AccuracySec=15s

[Install]
WantedBy=timers.target
""",
}


def write_units(unit_dir, exe):
    os.makedirs(unit_dir, exist_ok=True)
    for name, text in UNITS.items():
        with open(os.path.join(unit_dir, name), "w") as f:
            f.write(text.replace("{exe}", exe).replace("{marker}", MARKER_NAME))


def merge_hooks(path, exe):
    """Add our SessionStart/SessionEnd hooks next to existing ones. Never rewrites a file it cannot parse."""
    data = load_json(path) if os.path.exists(path) and os.path.getsize(path) else {}
    if not isinstance(data, dict):
        print(f"{path}: unreadable or not a JSON object, not changed", file=sys.stderr)
        return False
    changed = False
    for ev, arg in (("SessionStart", "start"), ("SessionEnd", "end")):
        cmd = f"{exe} hook {arg}"
        groups = data.setdefault("hooks", {}).setdefault(ev, [])
        if not any(h.get("command") == cmd for g in groups for h in g.get("hooks", [])):
            groups.append({"hooks": [{"type": "command", "command": cmd, "timeout": 5}]})
            changed = True
    if changed:
        if os.path.exists(path):
            shutil.copyfile(path, f"{path}.bak-claude-persist-{time.strftime('%Y%m%d-%H%M%S')}")
        write_json(path, data)
    print(f"{path}: hooks {'added' if changed else 'already present'}")
    return True


def run(*cmd):
    subprocess.run(list(cmd), check=True)


def boot_time():
    with open("/proc/stat") as f:
        return next(int(line.split()[1]) for line in f if line.startswith("btime "))


def unrestored_snapshot(snap, ctl):
    """True when `snap` predates this boot and the restore unit has not run yet: install must not let a snapshot
    replace it (re-running install after a reboot, before restore). A snapshot written during this boot (e.g. by an
    older version being upgraded) is current, not unrestored."""
    return (os.path.exists(snap) and os.path.getmtime(snap) < boot_time() and subprocess.run(
        [*ctl, "is-active", "--quiet", "claude-persist-restore.service"], check=False).returncode != 0)


PENDING_NOTE = "NOTE: the last snapshot has not been restored yet; snapshots resume after `claude-persist restore`"


def cmd_install(args):
    """claude-persist install               this user: PATH link, hooks in settings.json, systemd user units, timer on
       claude-persist install --global USER   (root, e.g. in a dev container) copies itself to /usr/local/bin, units for
                                              every user, hooks in /etc/claude-code/managed-settings.json, lingering +
                                              timer for USER"""
    me = os.path.realpath(__file__)
    if args[:1] == ["--global"]:
        if len(args) < 2 or os.geteuid() != 0:
            print("usage (as root): claude-persist install --global <user>", file=sys.stderr)
            return 2
        try:
            owner = pwd.getpwnam(args[1])
        except KeyError:
            print(f"no such user: {args[1]}", file=sys.stderr)
            return 2
        # every user runs this file: it must be root-owned. Copy then rename, so a symlink at SYSTEM_EXE is replaced
        # (not written through) and a hook starting meanwhile never reads a half-written file.
        target = me
        if me != SYSTEM_EXE:
            target = f"{SYSTEM_EXE}.tmp"
            shutil.copyfile(me, target)
        os.chown(target, 0, 0)
        os.chmod(target, 0o755)
        if target != SYSTEM_EXE:
            os.replace(target, SYSTEM_EXE)
        write_units("/etc/systemd/user", SYSTEM_EXE)
        run("systemctl", "--global", "enable", *ENABLED)
        os.makedirs("/etc/claude-code", mode=0o755, exist_ok=True)
        if not merge_hooks("/etc/claude-code/managed-settings.json", SYSTEM_EXE):
            return 1
        os.chmod("/etc/claude-code/managed-settings.json", 0o644)
        run("loginctl", "enable-linger", owner.pw_name)
        run("systemctl", "start", f"user@{owner.pw_uid}.service")       # blocks until the user manager is ready
        uctl = ["systemctl", "--user", "-M", f"{owner.pw_name}@"]
        run(*uctl, "daemon-reload")
        marker = f"/run/user/{owner.pw_uid}/{MARKER_NAME}"
        if not os.path.exists(marker):
            if unrestored_snapshot(os.path.join(owner.pw_dir, ".local/state/claude-persist/snapshot.json"), uctl):
                print(PENDING_NOTE)
            else:
                touch_marker(marker, owner)
        run(*uctl, "start", "claude-persist-snapshot.timer", "claude-persist-snapshot.service")
        run("su", "-", owner.pw_name, "-c", f"{SYSTEM_EXE} status | head -1")
        return 0
    link = os.path.join(HOME, ".local/bin/claude-persist")
    os.makedirs(os.path.dirname(link), exist_ok=True)
    if os.path.realpath(link) != me:
        if os.path.lexists(link):
            os.remove(link)
        os.symlink(me, link)
    if not merge_hooks(os.path.join(CLAUDE_DIR, "settings.json"), "$HOME/.local/bin/claude-persist"):
        return 1
    write_units(os.path.join(HOME, ".config/systemd/user"), "%h/.local/bin/claude-persist")
    run("systemctl", "--user", "daemon-reload")
    run("systemctl", "--user", "enable", *ENABLED)    # restore runs at the next boot, not now
    if not os.path.exists(MARKER):
        if unrestored_snapshot(SNAP, ["systemctl", "--user"]):
            print(PENDING_NOTE)
        elif not touch_marker():
            print(f"NOTE: cannot create {MARKER}, so snapshots do not run (is there a systemd user session?)")
    run("systemctl", "--user", "start", "claude-persist-snapshot.timer")
    cmd_snapshot()
    linger = subprocess.run(["loginctl", "show-user", os.environ.get("USER", ""), "-p", "Linger", "--value"],
                            capture_output=True, text=True, check=False).stdout.strip()
    if linger != "yes":
        print("NOTE: lingering is off, so nothing is restored at boot. Enable it:  sudo loginctl enable-linger $USER")
    return cmd_status()


def print_pane_session(target):
    cpid = claude_in_pane(pane_pid_of(target))
    print(*(session_of(cpid)[:2] if cpid else ()))


def main(argv):
    cmds = {
        "snapshot": lambda _a: cmd_snapshot(),
        "restore": lambda a: cmd_restore("--dry-run" in a),
        "status": lambda _a: cmd_status(),
        "install": cmd_install,
        "hook": lambda a: cmd_hook(a[0]) if a and a[0] in ("start", "end") else 2,
        "_pane-session": lambda a: print_pane_session(a[0]),                       # internal, used by tests/e2e.sh
        "_answer-trust": lambda a: print(answer_trust_prompt(pane_pid_of(a[0]), a[0])),
    }
    if len(argv) < 2 or argv[1] not in cmds:
        print(__doc__)
        return 0 if len(argv) < 2 or argv[1] in ("-h", "--help") else 2
    return cmds[argv[1]](argv[2:]) or 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
